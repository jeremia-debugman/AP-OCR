# AI Provider Selection: 'gemini', 'qwen', or 'deepseek'
AI_PROVIDER=gemini

# Google Gemini API Key (Required when AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Alibaba Qwen / DashScope API Key (Required when AI_PROVIDER=qwen)
QWEN_API_KEY=
DASHSCOPE_API_KEY=

# DeepSeek API Key (Required when AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini/gemini-1.5-flash
# QWEN_MODEL=dashscope/qwen-vl-plus
